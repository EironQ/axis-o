# Airwallex Payment Configuration
# https://developers.airwallex.com/

# Client ID (from Airwallex Dashboard > Settings > API Keys)
AIRWALLEX_CLIENT_ID=your_client_id_here

# API Key (from Airwallex Dashboard > Settings > API Keys)
AIRWALLEX_API_KEY=your_api_key_here

# Webhook Signing Key (from Airwallex Dashboard > Settings > Webhooks)
AIRWALLEX_WEBHOOK_SIGNING_KEY=your_webhook_signing_key_here

# Mode: sandbox (testing) or live (production)
AIRWALLEX_MODE=sandbox
